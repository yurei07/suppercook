// Suppercook database schema.
//
// Local development uses SQLite (zero setup, file in prisma/dev.db).
// Production should switch the datasource provider to postgresql and point
// DATABASE_URL at a real server — the models stay the same.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Аккаунт из /auth/register. userId в InventoryItem/ShoppingItem/AiUsage
// остаётся строкой без FK — так проще с legacy-заголовком x-user-id
// и тестами; связи ужесточим при переезде на PostgreSQL.
model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model InventoryItem {
  id       String   @id
  userId   String
  name     String
  quantity Float
  unit     String
  source   String   @default("manual")
  addedAt  DateTime @default(now())

  @@index([userId])
}

model ShoppingItem {
  id        String   @id
  userId    String
  name      String
  quantity  Float
  unit      String
  checked   Boolean  @default(false)
  // JSON array of recipe ids, e.g. ["r1","r2"]. SQLite has no array column.
  recipeIds String   @default("[]")

  @@index([userId])
}

// Счётчик AI-генераций на пользователя за день (ключ userId + YYYY-MM-DD UTC).
// Дневной лимит задаётся AI_DAILY_LIMIT, см. src/ai/quota.service.ts.
model AiUsage {
  id     String @id
  userId String
  day    String
  count  Int    @default(0)

  @@unique([userId, day])
}
