# --- Suppercook API ---

# Порт сервера
PORT=3000

# AI-провайдер: "mock" (работает без ключа) | "openai"
AI_PROVIDER=mock

# Ключ OpenAI (нужен только при AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Антропик — альтернатива (пока не подключён, заготовка)
ANTHROPIC_API_KEY=

# Режим разработки: in-memory (по умолчанию) | postgres (TODO: Prisma)
STORAGE_DRIVER=in-memory
