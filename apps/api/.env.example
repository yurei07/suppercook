# --- Suppercook API ---

# Порт сервера
PORT=3000

# Секрет подписи JWT (обязательно в продакшене!). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# AI-провайдер: "mock" (работает без ключа) | "openai"
AI_PROVIDER=mock

# Ключ OpenAI (нужен только при AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Дневной лимит AI-генераций на пользователя (рецепты + распознавание фото).
# Превышение -> 429. Это же основа freemium-тарифа.
AI_DAILY_LIMIT=20

# Rate limiting (@nestjs/throttler): глобально 120 req/мин на IP,
# на AI-эндпоинты и /auth/* — 10 req/мин (зашито в коде).

# CORS: разрешённые origins через запятую (для web-клиента).
# Не задано — отражаем любой origin (нормально для dev, в проде задай список).
CORS_ORIGINS=

# Антропик — альтернатива (пока не подключён, заготовка)
ANTHROPIC_API_KEY=

# База данных. Локально — SQLite (файл apps/api/prisma/dev.db).
# Для продакшена: смените provider на postgresql в prisma/schema.prisma
# и укажите URL сервера.
DATABASE_URL="file:./dev.db"

# --- Только NixOS ---
# Prisma не собирает движки под nixos. Соберите их из nixpkgs и раскомментируйте:
#   nix-build '<nixpkgs>' -A prisma-engines_6 -o apps/api/.nix-engines
#PRISMA_SCHEMA_ENGINE_BINARY=/abs/path/to/apps/api/.nix-engines/bin/schema-engine
#PRISMA_QUERY_ENGINE_LIBRARY=/abs/path/to/apps/api/.nix-engines/lib/libquery_engine.node
#PRISMA_FMT_BINARY=/abs/path/to/apps/api/.nix-engines/bin/prisma-fmt
